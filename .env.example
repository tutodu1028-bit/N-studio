# Renomme ce fichier en .env puis remplis-le.
# NE PARTAGE JAMAIS CE FICHIER, il contient ton token.

DISCORD_TOKEN=colle_ton_token_ici

# Optionnel : l'ID de ton serveur.
# Si tu le mets, les commandes slash apparaissent instantanement sur ce serveur.
# Sinon, elles sont globales et peuvent mettre jusqu'a 1h a apparaitre.
GUILD_ID=
